# EnglishFlow Environment Variables Example

# Database
DB_NAME=englishflow
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_PORT=5432

# Backend
BACKEND_PORT=8080
JWT_SECRET=replace_with_a_secure_base64_encoded_secret_key_minimum_256_bits
JWT_EXPIRATION_MS=86400000

# Frontend
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
